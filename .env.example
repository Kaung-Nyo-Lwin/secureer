# Defaults work locally without an .env file. Django reads environment variables;
# load this file into your shell as described in README.md.
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
SECUREER_ENGINE=demo

# Required with DJANGO_DEBUG=False. Generate a fresh value for your deployment.
# DJANGO_SECRET_KEY=
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.example
# DJANGO_HTTPS=True
# DJANGO_TRUST_PROXY=True

# Optional: use a separate database or persistent storage directory.
# SECUREER_DATA_DIR=/app/var
# DJANGO_DB_PATH=/absolute/path/to/db.sqlite3
